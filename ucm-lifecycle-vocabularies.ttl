@prefix ucm: <http://mdixinc.com/ucm#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

###  https://www.w3.org/ns/ucm#LifecycleState
ucm:LifecycleState a skos:ConceptScheme ;
    dcterms:title "UCM Lifecycle State"@en ;
    dcterms:description "A state associated with a process during a portion of its lifecycle."@en ;
    dcterms:created "2026-09-08"^^xsd:date ;
    dcterms:publisher "MDIX"@en ;
    skos:prefLabel "Lifecycle State"@en ;
    skos:definition "The primary state of the care coordination lifecycle."@en ;
    skos:hasTopConcept 
        ucm:Pending, 
        ucm:Accepted, 
        ucm:Declined .

ucm:Pending a skos:Concept ;
    skos:inScheme ucm:LifecycleState ;
    skos:topConceptOf ucm:LifecycleState ;
    skos:prefLabel "Pending Care Coordination Lifecycle"@en ;
    skos:altLabel "Pending"@en ;
    skos:definition "A pending care coordination request." . 

ucm:Accepted a skos:Concept ;
    skos:inScheme ucm:LifecycleState ;
    skos:topConceptOf ucm:LifecycleState ;
    skos:prefLabel "Accepted Care Coordination Lifecycle"@en ;
    skos:altLabel "Accepted"@en ;
    skos:definition "A care coordination request that has been accepted for ongoing care." . 

ucm:Declined a skos:Concept ;
    skos:inScheme ucm:LifecycleState ;
    skos:topConceptOf ucm:LifecycleState ;
    skos:prefLabel "Declined Care Coordination Lifecycle"@en ;
    skos:altLabel "Declined"@en ;
    skos:definition "This care request was denied." . 

###  https://www.w3.org/ns/ucm#ReferralDisposition
ucm:ReferralDisposition a skos:ConceptScheme ;
    dcterms:title "UCM Referral Disposition"@en ;
    dcterms:description "A state associated with a care coordination request during the process of its fulfillment of negotiated activity."@en ;
    dcterms:created "2026-09-08"^^xsd:date ;
    dcterms:publisher "MDIX"@en ;
    skos:prefLabel "Referral Disposition"@en ;
    skos:definition "The primary state of the referral lifecycle."@en ;
    skos:hasTopConcept 
        ucm:Pending, 
        ucm:Accepted, 
        ucm:Declined,
        ucm:Withdrawn,
        ucm:Expired, 
        ucm:Completed .

###  https://www.w3.org/ns/ucm#ServicesTransferred
ucm:ServicesTransferred a skos:ConceptScheme ;
    dcterms:title "UCM Services Transferred"@en ;
    dcterms:description "A state associated with the transfer of care during the process of a handshake."@en ;
    dcterms:created "2026-09-08"^^xsd:date ;
    dcterms:publisher "MDIX"@en ;
    skos:prefLabel "Services Transferred"@en ;
    skos:definition "The primary state of care coordination handoff through jointly agreed upon services."@en ;
    skos:hasTopConcept 
        ucm:Pending, 
        ucm:Accepted, 
        ucm:Declined,
        ucm:Withdrawn,
        ucm:Expired,
        ucm:Completed . 

###  https://www.w3.org/ns/ucm#HandshakeFulfillment
ucm:HandshakeFulfillment a skos:ConceptScheme ;
    dcterms:title "UCM Handshake Fulfillment"@en ;
    dcterms:description "A state associated with the degree of intended services rendered during the process of a handshake."@en ;
    dcterms:created "2026-09-08"^^xsd:date ;
    dcterms:publisher "MDIX"@en ;
    skos:prefLabel "Handshake Fulfillment"@en ;
    skos:definition "The primary state of the fulfilled services following the negotiated participation of a handshake."@en ;
    skos:hasTopConcept 
        ucm:Received, 
        ucm:PartiallyExecuted, 
        ucm:Delayed,
        ucm:ProviderDeclined,
        ucm:PendingConfirmation, 
        ucm:Completed .

###  https://www.w3.org/ns/ucm#ClosureReason
ucm:ClosureReason a skos:ConceptScheme ; 
    dcterms:title "UCM Closure Reason"@en ;
    dcterms:description "A state associated with the degree of intended services rendered during the process of a handshake."@en ;
    dcterms:created "2026-09-08"^^xsd:date ;
    dcterms:publisher "MDIX"@en ;
    skos:prefLabel "Closure Reason"@en ;
    skos:definition "The primary state of the fulfilled services following the negotiated participation of a handshake."@en ;
    skos:hasTopConcept 
        ucm:OutOfArea, 
        ucm:ProgramCapacity, 
        ucm:MissingVerification,
        ucm:Ineligible,
        ucm:Other, 
