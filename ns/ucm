<https://www.w3.org/ns/ucm>
  a owl:Ontology ;
  dcterms:title "Unified Care Model (UCM) Vocabulary"@en ;
  dcterms:description "UCM is an RDF vocabulary providing a common semantic foundation for achieving semantic interoperability across healthcare and human-service ecosystems. It serves as a semantic bridge that enables standards, ontologies, information models, and data models developed by independent communities to communicate with a shared understanding of information while preserving their respective semantics."@en ;
  dcterms:created "2025-01-01"^^xsd:date ;
  dcterms:modified "2026-10-15"^^xsd:date ;
  dcterms:creator <https://www.w3.org/community/ucm/> ;
  dcterms:publisher [
      a org:Organization ;
      foaf:homepage <https://www.w3.org/> ;
      foaf:name "World Wide Web Consortium (W3C)" ;
    ] ;
  dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
  dcterms:isPartOf <https://www.w3.org/community/ucm/> ;
  owl:versionInfo "0.0.1" ;
  owl:versionIRI <https://www.w3.org/ns/ucm/0.0.1> ;
  rdfs:label "Unified Care Model (UCM) Vocabulary"@en ;
  rdfs:comment "UCM is an RDF vocabulary providing a common semantic foundation for achieving semantic interoperability across healthcare and human-service ecosystems."@en ;
  rdfs:seeAlso <https://www.w3.org/community/ucm/> ;
  vann:preferredNamespacePrefix "ucm" ;
  vann:preferredNamespaceUri "https://www.w3.org/ns/ucm#" ;
  foaf:homepage <https://www.w3.org/community/ucm/> ;
.

#################################################################
#    Core Classes
#################################################################

ucm:Entity
  a rdfs:Class, owl:Class ;
  rdfs:label "Entity"@en ;
  rdfs:comment "A stable, independently identifiable semantic thing."@en ;
  skos:definition "A stable, independently identifiable semantic thing."@en ;
  rdfs:isDefinedBy <https://www.w3.org/ns/ucm> ;
.

ucm:Person
  a rdfs:Class, owl:Class ;
  rdfs:subClassOf ucm:Entity ;
  rdfs:label "Person"@en ;
