  skos:definition "A human individual with the social context of a person."@en ;
  rdfs:isDefinedBy <https://www.w3.org/ns/ucm> ;
.

ucm:Organization
  a rdfs:Class, owl:Class ;
  rdfs:subClassOf ucm:Entity ;
  rdfs:label "Organization"@en ;
