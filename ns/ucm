  skos:definition "The contextual involvement of an Entity within a Process and Semantic Context."@en ;
  rdfs:isDefinedBy <https://www.w3.org/ns/ucm> ;
.

ucm:Role
  a rdfs:Class, owl:Class ;
  rdfs:label "Role"@en ;
